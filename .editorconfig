root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,js,css}]
indent_size = 2

# Generated output — never let an editor reformat what the builders write.
[docs/**]
insert_final_newline = false
trim_trailing_whitespace = false
