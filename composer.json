{
    "name": "mahdimajidzadeh/ds",
    "description": "Majid DS — an RTL/Persian-first UI kit for Laravel Livewire, built on top of Flux UI with extra e-commerce components.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/MahdiMajidzadeh/majid-ds",
    "support": {
        "issues": "https://github.com/MahdiMajidzadeh/majid-ds/issues",
        "source": "https://github.com/MahdiMajidzadeh/majid-ds",
        "docs": "https://mahdimajidzadeh.github.io/majid-ds/"
    },
    "keywords": [
        "laravel",
        "livewire",
        "flux",
        "blade",
        "ui-kit",
        "rtl",
        "persian",
        "farsi",
        "e-commerce"
    ],
    "authors": [
        {
            "name": "Mahdi Majidzadeh"
        }
    ],
    "require": {
        "php": "^8.2",
        "afatmustafa/blade-hugeicons": "^2.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^3.7.4|^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "MajidDs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MajidDs\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MajidDs\\MajidDsServiceProvider"
            ],
            "aliases": {
                "Mds": "MajidDs\\Mds"
            }
        },
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite.",
        "lint": "Check formatting with Pint, changing nothing. CI runs this; locally, prefer `composer fix`.",
        "fix": "Apply Pint formatting.",
        "analyse": "Run PHPStan/Larastan static analysis.",
        "check": "The local loop: analyse, then test. Formatting is CI's job — run `composer fix` before pushing if you like, but nothing here waits on it."
    }
}
